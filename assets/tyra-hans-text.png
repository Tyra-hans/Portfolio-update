[{"type": "text", "text": "<assets>"}, {"type": "image", "source": {"type": "base64", "media_type": "image/png", "data": ""}}, {"type": "text", "text": "<!-- The actual image sizes are likely to be larger than the visible size in the design -->\n\nThe above assets are available in the data://assets/ location using the copy_file tool. \nGive the files meaningful names when copying them.\n\n<system-reminder>\nRefer to <icon-coding-guidelines> and <asset-coding-guidelines> on how to use them in the code.<system-reminder>\n</assets>"}]